{
  "name": "Readmissions Clinical Theme",
  "dataColors": [
    "#1B5E7D",
    "#2E86AB",
    "#5DA9C7",
    "#F2A541",
    "#6BAA75",
    "#8E6C9A",
    "#D9647E",
    "#4A4E69",
    "#C9A66B",
    "#7FB3B0"
  ],
  "background": "#FFFFFF",
  "foreground": "#252423",
  "tableAccent": "#1B5E7D",
  "good": "#6BAA75",
  "bad": "#D9647E",
  "neutral": "#F2A541",
  "maximum": "#1B5E7D",
  "center": "#5DA9C7",
  "minimum": "#EAEAEA",
  "null": "#C8C8C8",
  "textClasses": {
    "callout": {
      "fontSize": 32,
      "fontFace": "Segoe UI Semibold",
      "color": "#1B5E7D"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#252423"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#252423"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#605E5C"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "fontSize": 12,
            "fontFace": "Segoe UI Semibold",
            "color": { "solid": { "color": "#252423" } },
            "background": { "solid": { "color": "#FFFFFF" } },
            "alignment": "left"
          }
        ],
        "border": [{ "show": false }],
        "background": [{ "transparency": 0 }]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#1B5E7D" } },
            "fontSize": 28,
            "fontFace": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "color": { "solid": { "color": "#605E5C" } },
            "fontSize": 12,
            "fontFace": "Segoe UI"
          }
        ],
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#F7F9FA" } },
            "transparency": 0
          }
        ]
      }
    },
    "multiRowCard": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#F7F9FA" } }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#F7F9FA" } }
          }
        ]
      }
    }
  }
}
